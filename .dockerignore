.git/
.gitignore
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
.env.*
node_modules/
frontend/node_modules/
tests/
coverage/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
dist/
*.egg-info/
.specify/
specs/
# Exclude scripts/, EXCEPT the graph loader CODE — the production image needs
# scripts/graph/reload_all.sh (prod Neo4j has no host ports, so the graph can only be loaded from
# inside the container). The generated *.jsonl/*.csv exports in scripts/graph/ carry library
# content and are rebuilt in-container at load time, so they stay excluded.
scripts/*
!scripts/graph
scripts/graph/*
!scripts/graph/*.py
!scripts/graph/*.sh
docs/
backups/
transcripts/
.DS_Store
Thumbs.db
*.md
!README.md
docker-compose.dev.yml
